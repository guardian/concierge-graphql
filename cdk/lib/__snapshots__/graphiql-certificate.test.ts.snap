            "Value": "TEST",
          },
          {
            "Key": "gu:repo",
            "Value": "guardian/concierge-graphql",
          },
          {
            "Key": "Name",
            "Value": "GraphiqlCertificate-useast-1-CODE-AARDVARK/CertificateGraphiqlexplorercertificates",
          },
          {
            "Key": "Stack",
            "Value": "content-api",
          },
          {
            "Key": "Stage",
            "Value": "CODE-AARDVARK",
          },
        ],
        "ValidationMethod": "DNS",
      },
